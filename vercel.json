{
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": [
        "*.html",
        "assets/**",
        "mm2/**",
        "blox-fruits/**",
        "profile/**",
        "topics/**",
        "oauth/**",
        "auth/**",
        "admin/**",
        "data/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/images/LinkEmbed.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0"
        }
      ]
    }
  ]
}